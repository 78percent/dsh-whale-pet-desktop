{
  "name": "@whale-pet/desktop-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Local DSH activity bridge for WhalePet Desktop",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "dsh": {
    "compatibility": {
      "dsh": "^0.1.0-rc.6 || ^0.1.2-rc.1 || ^0.2.0-rc.2",
      "node": "^22.19.0 || >=24.0.0",
      "platform": "web",
      "externalCredentials": "optional"
    },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-runtime"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || ^4.0.4",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6 || ^0.1.2-rc.1 || ^0.2.0-rc.2"
  }
}
